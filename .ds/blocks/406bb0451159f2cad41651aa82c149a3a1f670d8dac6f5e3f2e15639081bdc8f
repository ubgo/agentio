func (c *Core) HomeFromEnv() (Home, bool) {
	if c.spec.HomeEnv == "" {
		return Home{}, false
	}
	v, ok := c.host.Getenv(c.spec.HomeEnv)
	if !ok || v == "" {
		return Home{}, false
	}
	if c.spec.HomeEnvNamesParent {
		v = filepath.Join(resolveHomeDir(c.host.hostOS(), c.host.UserHome, v), c.spec.DefaultHome)
	}
	return c.HomeAt(v), true
}