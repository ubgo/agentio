func packageVersion(path string) agentio.Version {
	b, err := os.ReadFile(path)
	if err != nil {
		return agentio.Version{}
	}
	var pkg struct {
		Version string `json:"version"`
	}
	if json.Unmarshal(b, &pkg) != nil {
		return agentio.Version{}
	}
	v, _ := agentio.ParseVersion(pkg.Version)
	return v
}